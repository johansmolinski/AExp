/* Megamiga: the /amiga folder of the SD card as the volume SDCard (MegamigaFS).
   Kickstart 1.3: copy this entry into DEVS:MountList and add "Mount SD:" to
   S:Startup-Sequence (2.0 and later: use DEVS:DOSDrivers/SD instead). */
SD:     FileSystem     = L:MegamigaFS
        Device         = dummy.device
        Unit           = 0
        Surfaces       = 1
        BlocksPerTrack = 10
        Reserved       = 2
        LowCyl         = 0
        HighCyl        = 100
        StackSize      = 4000
        DosType        = 0x4D534400
        Mount          = 1
#
